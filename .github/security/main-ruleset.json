{
  "name": "main-security-baseline",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "test (ubuntu-latest)", "integration_id": 15368},
          {"context": "test (macos-latest)", "integration_id": 15368},
          {"context": "test (windows-latest)", "integration_id": 15368},
          {"context": "lint (linux)", "integration_id": 15368},
          {"context": "lint (darwin)", "integration_id": 15368},
          {"context": "lint (windows)", "integration_id": 15368},
          {"context": "vuln", "integration_id": 15368},
          {"context": "gosec", "integration_id": 15368},
          {"context": "Dependency review", "integration_id": 15368},
          {"context": "CodeQL (go, linux)", "integration_id": 15368},
          {"context": "CodeQL (go, darwin)", "integration_id": 15368},
          {"context": "CodeQL (go, windows)", "integration_id": 15368},
          {"context": "CodeQL (actions)", "integration_id": 15368}
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "high_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    }
  ]
}
